{
  "name": "dsh-remote-control-plugin",
  "version": "0.7.66",
  "type": "module",
  "description": "Remote control for DSH: a Devices panel that discovers other DSH desktops signed into the same account, pairs with them once, and drives their sessions.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "INSTALL.md",
    "SECURITY.md",
    "web/index.html",
    "web/app.js",
    "web/app.css",
    "web/icon.svg",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "license": "MIT",
  "author": {
    "name": "Kangrong Hu",
    "email": "16051414+kangronghuuu@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kangronghuuu/dsh-remote-control.git"
  },
  "homepage": "https://www.npmjs.com/package/dsh-remote-control-plugin",
  "bugs": {
    "email": "16051414+kangronghuuu@users.noreply.github.com"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "remote-control",
    "tailscale",
    "pairing",
    "mobile",
    "chat"
  ],
  "engines": {
    "node": ">=20"
  }
}
